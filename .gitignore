venv/
env/

# Кеш і скомпільовані файли Python
__pycache__/
*.py[cod]
*.egg-info/

# Службові папки редакторів
.idea/
.vscode/

# Результати збирання PyInstaller (важкі, збираються командою заново)
build/
dist/
*.spec

# Кеші інструментів
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Системні файли
Thumbs.db
.DS_Store
